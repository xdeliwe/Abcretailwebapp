@{
    ViewData["Title"] = "Home";
}

<style>
    .retail-hero {
        background: linear-gradient(135deg, #0d6efd, #0a3d91);
        color: white;
        border-radius: 18px;
        padding: 3rem 2rem;
        margin-bottom: 2rem;
    }

    .feature-card {
        border: 0;
        border-radius: 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.14) !important;
        }

    .feature-icon {
        font-size: 2rem;
    }
</style>

<div class="retail-hero text-center shadow">
    <p class="text-uppercase fw-semibold mb-2">ABC Retail Web App</p>
    <h1 class="display-5 fw-bold">Your retail operations, in one place.</h1>
    <p class="lead mb-0">
        Manage customer records, products, order messages, and files using Azure Storage.
    </p>
</div>

<div class="text-center mb-4">
    <h2 class="fw-bold">Storage Services</h2>
    <p class="text-muted">Choose a section to manage your retail data.</p>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card feature-card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="feature-icon mb-3">👥</div>
                <h4 class="card-title">Customers</h4>
                <p class="card-text text-muted">
                    Customer records stored in Azure Table Storage.
                </p>
                <a asp-controller="Customers" asp-action="Index" class="btn btn-primary mt-auto">View Customers</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card feature-card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="feature-icon mb-3">📦</div>
                <h4 class="card-title">Products</h4>
                <p class="card-text text-muted">
                    Product information and images in Azure Blob Storage.
                </p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-auto">View Products</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card feature-card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="feature-icon mb-3">📨</div>
                <h4 class="card-title">Order Queue</h4>
                <p class="card-text text-muted">
                    Transaction messages handled through Azure Queue Storage.
                </p>
                <a asp-controller="Queue" asp-action="Index" class="btn btn-primary mt-auto">View Queue</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card feature-card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="feature-icon mb-3">📁</div>
                <h4 class="card-title">File Storage</h4>
                <p class="card-text text-muted">
                    Text files securely stored in Azure File Storage.
                </p>
                <a asp-controller="Files" asp-action="Index" class="btn btn-primary mt-auto">View Files</a>
            </div>
        </div>
    </div>
</div>




